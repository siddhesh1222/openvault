# OpenVault configuration.
# Copy this file to `.env` (in the repository root) and fill in the values.
# `.env` is listed in .gitignore and must NEVER be committed.

# ---------------------------------------------------------------------------
# Secrets (REQUIRED)
# ---------------------------------------------------------------------------
# Signs login tokens (JWT). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# AES-256 key used to encrypt every stored file. Must be base64 of 32 bytes:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: if you lose or change this key, existing files can no longer be decrypted.
ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------------------
# Database & storage
# ---------------------------------------------------------------------------
# SQLite (default, for development):
DATABASE_URL=sqlite:///./data/openvault.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://openvault:openvault@localhost:5432/openvault

# Folder where encrypted file blobs and backups are stored.
STORAGE_DIR=./data/storage

# ---------------------------------------------------------------------------
# Accounts & limits
# ---------------------------------------------------------------------------
# The first registered user is always an admin. This email also becomes admin.
ADMIN_EMAIL=
ACCESS_TOKEN_EXPIRE_MINUTES=60
FILE_LINK_EXPIRE_MINUTES=5
DEFAULT_QUOTA_MB=1024
MAX_UPLOAD_MB=100
MAX_VERSIONS=10

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Frontend origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
ENABLE_SCHEDULER=true
